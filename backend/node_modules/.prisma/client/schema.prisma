datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  users       User[]
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  roleId        Int
  role          Role           @relation(fields: [roleId], references: [id])
  driver        Driver?
  passenger     Passenger?
  notifications Notification[]
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Driver {
  id                 Int          @id @default(autoincrement())
  userId             Int?         @unique
  user               User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String       @unique
  licenseExpiry      DateTime
  medicalStatus      String?
  availabilityStatus String       @default("AVAILABLE") // AVAILABLE, ON_DUTY, OFF_DUTY, SUSPENDED
  performanceScore   Decimal      @default(5.0) @db.Decimal(3, 2)
  schedules          Schedule[]
  attendances        Attendance[]
  documents          Document[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Bus {
  id                 Int           @id @default(autoincrement())
  registrationNumber String        @unique
  model              String
  capacity           Int
  status             String        @default("AVAILABLE") // AVAILABLE, RUNNING, MAINTENANCE, INACTIVE
  category           String        @default("NON_AC_SEATER") // AC_SEATER, NON_AC_SEATER, AC_SLEEPER, NON_AC_SLEEPER
  schedules          Schedule[]
  maintenances       Maintenance[]
  fuelLogs           FuelLog[]
  documents          Document[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  documentType String // PERMIT, FITNESS, INSURANCE, LICENSE
  fileUrl      String
  expiryDate   DateTime
  busId        Int?
  bus          Bus?     @relation(fields: [busId], references: [id], onDelete: Cascade)
  driverId     Int?
  driver       Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Route {
  id            Int         @id @default(autoincrement())
  name          String
  startLocation String
  endLocation   String
  totalDistance Decimal     @db.Decimal(6, 2)
  totalDuration Int // in minutes
  stops         RouteStop[]
  schedules     Schedule[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model RouteStop {
  id        Int     @id @default(autoincrement())
  routeId   Int
  route     Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName  String
  stopOrder Int
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  etaOffset Int // minutes from start
}

model Schedule {
  id            Int      @id @default(autoincrement())
  routeId       Int
  route         Route    @relation(fields: [routeId], references: [id])
  busId         Int
  bus           Bus      @relation(fields: [busId], references: [id])
  driverId      Int
  driver        Driver   @relation(fields: [driverId], references: [id])
  departureTime String // e.g. "08:30"
  arrivalTime   String // e.g. "09:45"
  recurrence    String   @default("DAILY") // DAILY, WEEKDAYS, WEEKENDS, HOLIDAYS
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  trips         Trip[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Trip {
  id              Int           @id @default(autoincrement())
  scheduleId      Int
  schedule        Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  actualDeparture DateTime?
  actualArrival   DateTime?
  status          String        @default("SCHEDULED") // SCHEDULED, RUNNING, COMPLETED, DELAYED, CANCELLED
  date            DateTime
  gpsLocations    GPSLocation[]
  attendances     Attendance[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GPSLocation {
  id        Int      @id @default(autoincrement())
  tripId    Int
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  speed     Decimal  @db.Decimal(5, 2)
  timestamp DateTime @default(now())
}

model Passenger {
  id            Int          @id @default(autoincrement())
  userId        Int?         @unique
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  passengerType String // STUDENT, FACULTY, EMPLOYEE, PUBLIC
  idCardNumber  String?      @unique
  student       Student?
  employee      Employee?
  attendances   Attendance[]
  complaints    Complaint[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Student {
  id          Int       @id @default(autoincrement())
  passengerId Int       @unique
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  rollNumber  String    @unique
  department  String
  batch       String
}

model Employee {
  id          Int       @id @default(autoincrement())
  passengerId Int       @unique
  passenger   Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  employeeId  String    @unique
  designation String
  department  String
}

model Attendance {
  id           Int        @id @default(autoincrement())
  date         DateTime
  checkInTime  DateTime
  checkOutTime DateTime?
  status       String     @default("PRESENT") // PRESENT, ABSENT, LATE
  driverId     Int?
  driver       Driver?    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  passengerId  Int?
  passenger    Passenger? @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  tripId       Int?
  trip         Trip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      String // DELAY, ALERT, MAINTENANCE, GENERAL
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Complaint {
  id                Int       @id @default(autoincrement())
  passengerId       Int
  passenger         Passenger @relation(fields: [passengerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  status            String    @default("SUBMITTED") // SUBMITTED, IN_INVESTIGATION, RESOLVED, CLOSED
  resolutionDetails String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Maintenance {
  id              Int       @id @default(autoincrement())
  busId           Int
  bus             Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  maintenanceType String // ROUTINE, REPAIR, INSPECTION
  description     String
  cost            Decimal   @db.Decimal(10, 2)
  scheduledDate   DateTime
  completedDate   DateTime?
  status          String    @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED
}

model FuelLog {
  id              Int      @id @default(autoincrement())
  busId           Int
  bus             Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  fuelQuantity    Decimal  @db.Decimal(6, 2) // in liters
  odometerReading Decimal  @db.Decimal(8, 1)
  cost            Decimal  @db.Decimal(8, 2)
  date            DateTime
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
}

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String
  description String?
}
